# EmotionVision AI - Example environment file
#
# This project requires NO API keys and NO paid services by default.
# This file is provided only in case you want to override optional
# advanced settings in the future (e.g., a custom model URL).
#
# Copy this file to ".env" if you need it. It is not required to run the app.

# Optional: override the model download URL (advanced / rarely needed)
# MODEL_SOURCE_URL_OVERRIDE=

# Optional: override default camera index
# CAMERA_INDEX=0
